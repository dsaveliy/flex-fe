# скопируйте в .env и перезапустите Metro (npx expo start --clear).
# без EXPO_PUBLIC_API_URL приложение работает на mock-данных

# сервер Flex (боевой):
# EXPO_PUBLIC_API_URL=https://flex.example.com/api/v1
# свой компьютер в той же Wi-Fi сети (бэкенд: uvicorn ... --host 0.0.0.0):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# принудительно mock, даже если адрес задан
# EXPO_PUBLIC_USE_MOCK=1
