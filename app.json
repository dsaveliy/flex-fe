{
  "expo": {
    "name": "Flex",
    "slug": "flex",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "by.flex.mobile"
    },
    "android": {
      "package": "by.flex.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-localization",
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Flex использует Face ID для входа в раздел Crypto"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Flex использует Face ID для входа в раздел Crypto"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flex открывает фото, чтобы вы могли отправить его в чате",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
