{
  "expo": {
    "name": "Flex",
    "slug": "flex",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "flex",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "by.flex.mobile"
    },
    "android": {
      "package": "by.flex.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-localization",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
